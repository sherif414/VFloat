{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "env.d.ts",
    "src/**/*.ts",
    "src/**/*.vue",
    "playground/**/*.vue",
    "playground/**/*.ts",
    "docs/**/*.ts",
    "docs/**/*.vue",
    "docs/**/*.md",
    "docs/.vitepress/**/*.ts",
    "docs/.vitepress/**/*.mts",
    "docs/.vitepress/**/*.vue",
    "docs/.vitepress/**/*.d.ts"
  ],
  "exclude": [
    "src/**/__tests__/*",
    "src/**/*.test.ts",
    "docs/**/*.test.ts",
    "docs/.vitepress/dist/**",
    "docs/.vitepress/cache/**"
  ],
  "vueCompilerOptions": {
    "vitePressExtensions": [".md"]
  },
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": false,
    "skipLibCheck": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],

    "paths": {
      "@/*": ["./src/*"],
      "v-float": ["./src/index.ts"]
    }
  }
}
