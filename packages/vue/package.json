{
  "name": "v-float",
  "version": "0.14.0",
  "description": "Vue 3 port of Floating UI - a library for positioning floating elements",
  "keywords": [
    "dropdown",
    "floating-ui",
    "popover",
    "popper",
    "positioning",
    "tooltip",
    "vue",
    "vue3"
  ],
  "homepage": "https://vfloat.pages.dev",
  "bugs": {
    "url": "https://github.com/sherif414/VFloat/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sherif414/VFloat.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:debug": "vitest --browser.headless=false --no-file-parallelism",
    "test:debug:run": "vitest run --browser.headless=false --no-file-parallelism",
    "test:trace": "vitest --browser.headless=false --browser.traceView --no-file-parallelism",
    "test:ssr": "vitest run --browser.enabled=false --environment node src/__tests__/ssr.test.ts",
    "test:coverage": "vitest run --coverage",
    "prepack": "node -e \"import('node:fs').then(fs => fs.existsSync('../../README.md') && fs.copyFileSync('../../README.md', './README.md'))\"",
    "postpack": "node -e \"import('node:fs').then(fs => fs.existsSync('./README.md') && fs.unlinkSync('./README.md'))\""
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0"
  },
  "devDependencies": {
    "@tanstack/vue-virtual": "^3.13.36",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/browser": "^5.0.0",
    "@vitest/browser-playwright": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^30.0.1",
    "playwright": "^1.63.0",
    "typescript": "~6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^5.0.0",
    "vitest-browser-vue": "^3.1.0",
    "vue": "^3.5.41"
  },
  "peerDependencies": {
    "vue": ">=3.5.0"
  }
}
