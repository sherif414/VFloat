{
  "git": {
    "commitMessage": "chore: release v${version}",
    "tagName": "v${version}",
    "pushRepo": "origin",
    "requireBranch": "main",
    "requireCleanWorkingDir": true
  },
  "npm": {
    "publish": false
  },
  "hooks": {
    "before:init": ["node ./scripts/release/before-init.mjs"],
    "before:bump": ["pnpm run lint", "pnpm run type-check", "pnpm run test", "pnpm run build"],
    "after:bump": [
      "pnpm exec changelogen -r ${version} --output CHANGELOG.md",
      "pnpm run size -- --quiet",
      "git add package.json CHANGELOG.md docs/.vitepress/data/package-size.json"
    ],
    "after:release": [
      "echo Successfully released ${name} v${version} to GitHub (npm publication triggered via CI)."
    ]
  },
  "github": {
    "release": true,
    "releaseName": "v${version}",
    "releaseNotes": "node ./scripts/release/release-notes.mjs ${version}"
  },
  "plugins": {}
}
