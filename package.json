{
  "name": "v-float",
  "version": "0.13.0",
  "private": false,
  "description": "Vue 3 port of Floating UI - a library for positioning floating elements",
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build tsconfig.build.json",
    "lint": "oxlint && oxfmt --check .",
    "lint:fix": "oxlint --fix && oxfmt --write .",
    "format": "oxfmt --write .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:deploy": "node scripts/release/deploy-docs.mjs",
    "size": "node scripts/release/measure-size.mjs",
    "release:dry": "node scripts/release/ci-release.mjs --dry-run",
    "changelog": "changelogen",
    "changelog:preview": "changelogen --no-output"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.6",
    "vue": "^3.5.31"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@tsconfig/node22": "^22.0.5",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^25.5.0",
    "@typescript/native-preview": "7.0.0-dev.20260327.2",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitest/browser": "^3.2.7",
    "@vitest/coverage-v8": "^3.2.7",
    "@vue/theme": "^2.4.0",
    "@vue/tsconfig": "^0.9.1",
    "changelogen": "^0.6.2",
    "jsdom": "^29.0.1",
    "npm-run-all2": "^8.0.4",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "playwright": "^1.58.2",
    "rollup": "4.60.1",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.3",
    "vite": "^6.2.0",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vitepress": "^1.6.4",
    "vitepress-plugin-demo": "^0.8.1",
    "vitest": "^3.2.7",
    "vitest-browser-vue": "^2.1.0",
    "vue-tsc": "^3.2.6",
    "wrangler": "^4.95.0"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}
