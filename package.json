{
  "name": "v-float-monorepo",
  "version": "0.14.0",
  "private": true,
  "description": "Vue 3 port of Floating UI - a library for positioning floating elements",
  "homepage": "https://vfloat.pages.dev",
  "bugs": {
    "url": "https://github.com/sherif414/VFloat/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sherif414/VFloat.git"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter v-float-playground dev",
    "playground": "pnpm --filter v-float-playground dev",
    "build": "pnpm --filter v-float build",
    "preview": "pnpm --filter v-float-playground preview",
    "lint": "oxlint && oxfmt --check .",
    "lint:fix": "oxlint --fix && oxfmt --write .",
    "format": "oxfmt --write .",
    "test": "pnpm --filter v-float test",
    "test:run": "pnpm --filter v-float test:run",
    "test:debug": "pnpm --filter v-float test:debug",
    "test:debug:run": "pnpm --filter v-float test:debug:run",
    "test:trace": "pnpm --filter v-float test:trace",
    "test:ssr": "pnpm --filter v-float test:ssr",
    "test:coverage": "pnpm --filter v-float test:coverage",
    "docs:dev": "pnpm --filter v-float-docs dev",
    "docs:build": "pnpm build && pnpm --filter v-float-docs build",
    "docs:preview": "pnpm --filter v-float-docs preview",
    "docs:deploy": "node scripts/release/deploy-docs.mjs",
    "docs:lint": "pnpm --filter v-float-docs lint",
    "docs:lint:fix": "pnpm --filter v-float-docs lint:fix",
    "docs:format": "pnpm --filter v-float-docs format",
    "adr:new": "node scripts/adr.ts new",
    "adr:index": "node scripts/adr.ts index",
    "size": "node scripts/release/measure-size.mjs",
    "release:dry": "node scripts/release/ci-release.mjs --dry-run",
    "changelog": "changelogen",
    "changelog:preview": "changelogen --no-output"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.0",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^26.2.0",
    "changelogen": "^0.6.2",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "~6.0.3",
    "wrangler": "^4.125.0"
  },
  "packageManager": "pnpm@11.23.0"
}
