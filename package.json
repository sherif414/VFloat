{
  "name": "v-float",
  "version": "0.13.2",
  "private": false,
  "description": "Vue 3 port of Floating UI - a library for positioning floating elements",
  "keywords": [
    "dropdown",
    "floating-ui",
    "popover",
    "popper",
    "positioning",
    "tooltip",
    "vue",
    "vue3"
  ],
  "homepage": "https://vfloat.pages.dev",
  "bugs": {
    "url": "https://github.com/sherif414/VFloat/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sherif414/VFloat.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "oxlint && oxfmt --check .",
    "lint:fix": "oxlint --fix && oxfmt --write .",
    "format": "oxfmt --write .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:debug": "vitest --browser.headless=false --no-file-parallelism",
    "test:debug:run": "vitest run --browser.headless=false --no-file-parallelism",
    "test:trace": "vitest --browser.headless=false --browser.traceView --no-file-parallelism",
    "test:ssr": "vitest run --browser.enabled=false --environment node src/__tests__/ssr.test.ts",
    "test:coverage": "vitest run --coverage",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:deploy": "node scripts/release/deploy-docs.mjs",
    "size": "node scripts/release/measure-size.mjs",
    "release:dry": "node scripts/release/ci-release.mjs --dry-run",
    "changelog": "changelogen",
    "changelog:preview": "changelogen --no-output"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/vue-virtual": "^3.13.36",
    "@tsconfig/node22": "^22.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/theme": "^2.4.0",
    "@vue/tsconfig": "^0.9.1",
    "changelogen": "^0.6.2",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright": "^1.62.1",
    "rollup": "4.60.1",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.0.3",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitepress": "^1.6.4",
    "vitepress-plugin-demo": "^0.8.1",
    "vitest": "^4.1.11",
    "vitest-browser-vue": "^2.1.0",
    "vue": "^3.5.41",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.125.0"
  },
  "peerDependencies": {
    "vue": ">=3.5.0"
  },
  "packageManager": "pnpm@11.23.0"
}
